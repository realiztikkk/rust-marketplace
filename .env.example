# Copy to .env and fill in. NEVER commit a real .env.
# APP_SECRET_KEY peppers password hashes — set a long random value ONCE
# and do not change it afterwards (changing it invalidates every password).
APP_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Optional: your Discord invite URL, shown on the homepage.
DISCORD_INVITE_URL=
# Base URL of the site, used for PayPal return/cancel links and
# password-reset links. Set this to your real domain when you go live.
APP_BASE_URL=http://localhost:8000

# --- PayPal Commerce Platform (the payment method) ---
# Buyer checkout + instant seller payouts (15% platform fee, seller
# keeps 85%). Leave empty to disable paid checkout: free downloads
# still work, and paid checkout shows "payments are not configured yet".
#
# Get SANDBOX credentials first (never start with live keys):
# https://developer.paypal.com/dashboard/applications/sandbox
# Create an app there and copy its client ID + secret below.
# PAYPAL_MODE=sandbox (default). Only set "live" deliberately, in .env,
# never in git — and only after a full sandbox checkout works end to end.
#
# Two more setup steps in the PayPal developer dashboard:
# 1. On your app's settings page, enable the "Platform Fee"
#    (PARTNER_FEE) feature — without it, order creation fails.
# 2. Create a webhook at <APP_BASE_URL>/paypal/webhook subscribed to
#    PAYMENT.CAPTURE.COMPLETED (and MERCHANT.ONBOARDING.COMPLETED if you
#    use Partner Referrals onboarding), and set PAYPAL_WEBHOOK_ID from it.
#    Without the webhook ID, the webhook endpoint returns 400.
#
# Sellers connect a PayPal account by saving their PayPal merchant ID
# in the seller dashboard (Account Settings > Business information >
# PayPal Merchant ID). Full automated onboarding via PayPal's Partner
# Referrals API is a later step and needs PayPal partner approval.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=
# Optional partner attribution ID (BN code) from PayPal, if you have one.
PAYPAL_BN_CODE=

# --- Stripe — SET ASIDE (not used) ---
# Stripe Checkout was the v2 payment method. It is no longer wired into
# checkout (see app/paypal_pay.py). STRIPE_SECRET_KEY,
# STRIPE_PUBLISHABLE_KEY and STRIPE_WEBHOOK_SECRET are ignored by the
# app now; leave them unset. Payments are PayPal Commerce Platform only,
# matching RogueDepot.

# --- Email / SMTP (optional) ---
# Leave empty to disable email: password reset shows the link on screen
# (dev mode) and no notification emails are sent. The site works fully
# without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
